{
  "name": "ghost-coding-cave",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "verifyDepsBeforeRun:": false,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @ghost/database generate",
    "db:migrate": "pnpm --filter @ghost/database migrate",
    "db:push": "pnpm --filter @ghost/database push",
    "db:studio": "pnpm --filter @ghost/database studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^6.0.0",
    "@types/node": "^26.6.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.12.1"
  }
}
