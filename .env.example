# Database
DATABASE_URL=postgresql://ghost:ghost@localhost:4000/ghost

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Configuration
API_PORT=5905
API_HOST=0.0.0.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4003
NEXT_PUBLIC_GHOST_LOG_WS_URL=ws://localhost:4005/ws/logs
DASHBOARD_PORT=5900

# Ollama Configuration
OLLAMA_HOST=http://localhost:4002
OLLAMA_MODEL=llama3

# Ghost Execution Service
GHOST_SERVER_URL=http://localhost:4005
GHOST_SERVER_API_KEY=ghost-dev-api
GHOST_LOG_WS_URL=ws://localhost:4005/ws/logs

# MCP Server Configuration (planned)
MCP_HOST=http://localhost:6010
MCP_ENABLED=false

# Mirror Services (Package Caches)
MIRROR_NPM_URL=http://localhost:4008
MIRROR_PYPI_URL=http://localhost:4009
MIRROR_CRATES_URL=http://localhost:8081

# Terminal Gateway (reserved)
# WS_TERMINAL_URL=ws://localhost:5910

# Token System
DEFAULT_START_TOKENS=1000
TOKEN_COST_RUN=50
TOKEN_COST_CHAT_MIN=10
TOKEN_COST_CHAT_MAX=50
TOKEN_COST_VERSION=5
TOKEN_COST_INSTALL=20

# Cave Configuration
ALLOWED_LANGUAGES=python,node,rust
MAX_CAVES_PER_PROJECT=3
CAVE_DEFAULT_RAM_MB=512
CAVE_DEFAULT_CPU_MILLICORES=500

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring
LOG_LEVEL=info
AUDIT_ENABLED=true
METRICS_ENABLED=true

# Development
NODE_ENV=development
